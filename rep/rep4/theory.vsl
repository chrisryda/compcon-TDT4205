func my_factorial(n) {

    var result, i, tmp
    result = 1
    i = 1
    tmp = 1
    
    if n == 0 then {
        result = -1
    }
    else if n < 0 then {
        result = -2
    }
    else {
        while i <= n do {
            tmp = result * i
            result = tmp
            i = i + 1
        }
    }
    
    return result
}

// Task 1.2: Make SSA

func my_factorial(n) {

    result0 = 1
    i0 = 1
    tmp0 = 1

    if n == 0 then {
        result1 = -1 % b2
    }

    else if n < 0 then {  % b3
        result2 = -2      % b4       
    }

    else {
        i1 = phi((i0, b3), (i2, b6))                   %b5 
        result3 = phi((result0, b3), (result4, b6))    %b5
        while i1 <= n do {                             %b5    
            tmp1 = result3 * i1 % b6
            result4 = tmp1      % b6                
            i2 = i1 + 1         % b6
        }
    }

    result5 = phi((result1, b2), (result2, b4), (result3, b5))
}

